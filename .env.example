# Copy to .env for local development: cp .env.example .env
# Required: TomTom key with Routing, Search, Geocoding and Reverse Geocoding enabled (free, no card).
TOMTOM_API_KEY=

# Optional overrides (defaults shown)
# TARE_LB=35000                 # tractor + trailer weight added to the load for TomTom's vehicleWeight
# TOMTOM_DAILY_LIMIT=2000       # stop new plans past this many TomTom calls per UTC day
# OPENMETEO_DAILY_LIMIT=9000    # switch checkpoints to NWS past this many Open-Meteo locations per day
# FORECAST_PROVIDER=open-meteo  # or "nws"
# FORECAST_TTL_S=7200
# NWS_USER_AGENT=TruckRoute/1.0 (+https://github.com/Siruyy/spotter-truck-routing)

# Production only (set in Dokploy)
# DJANGO_SECRET_KEY=
# POSTGRES_PASSWORD=
# PUBLIC_HOST=truckroute.siruyy.dev
